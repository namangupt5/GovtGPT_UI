# =============================================================================
# U-Ask UAE Government Chatbot - Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================================

# HuggingFace Configuration (Free - for model downloads, optional)
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here

# U-Ask Application Credentials
UASK_USERNAME=your_username@example.com
UASK_PASSWORD=your_password_here
UASK_BASE_URL=https://govgpt.sandbox.dge.gov.ae/

# Test Environment
TEST_ENV=staging
DEBUG_MODE=false
HEADLESS_MODE=true

# Reporting
ALLURE_RESULTS_DIR=reports/allure-results
SCREENSHOT_ON_FAILURE=true
VIDEO_RECORDING=false

# AI Models Cache Directory (Free local storage)
TRANSFORMERS_CACHE=.cache/transformers
SENTENCE_TRANSFORMERS_HOME=.cache/sentence_transformers

